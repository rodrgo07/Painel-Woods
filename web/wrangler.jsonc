// Cloudflare Workers (static assets): publica o build do Vite (dist/) como site estático.
// Sem código de servidor. O web/public/_headers vale aqui também.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "woods-web",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
