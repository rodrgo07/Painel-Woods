# Só para quem desenvolve (npm start). O app instalado não lê este arquivo: tudo é configurado na tela.
# Copie para .env. Tudo é opcional.

# Pasta dos dados no lugar de %APPDATA%\PainelWoods (para testar sem mexer nos dados de verdade)
# PAINEL_DADOS=C:\temp\painel-teste

# Usar um WOODS que já existe no lugar de <dados>\WOODS
# WOODS_DIR=C:\Users\Rodrigo\Documents\WOODS

# Clonar o WOODS de outro lugar (por exemplo, um clone local) no lugar do GitHub
# WOODS_REPO=C:\Users\Rodrigo\Documents\WOODS

# Chave da API no lugar do login ou da chave guardada pela tela de configurações
# ANTHROPIC_API_KEY=
